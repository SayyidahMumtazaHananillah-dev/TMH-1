# Godot 4 - Cache & Generated files
.godot/

# Exported builds
*.apk
*.exe
build/

# System / OS files
.DS_Store
Thumbs.db

# ============================================
# File SUMBER MENTAH yang TIDAK perlu di-push
# (simpan di lokal saja, bukan bagian dari game)
# ============================================

# Blender source files & backups
*.blend
*.blend1

# Archive files (ZIP, RAR sudah diekstrak)
*.zip
*.rar

# Format 3D mentah yang BUKAN Godot
*.fbx

# File format non-Godot (Blender material/USD)
*.mtlx
*.usdc

# ============================================
# FOLDER di luar project Godot (source assets)
# ============================================
/Assets library/
/TEXTURE/
/TEXTURE 2/

# Root-level GLB duplikat (bukan bagian project)
/dindingHijau.glb
/dindingPutih.glb